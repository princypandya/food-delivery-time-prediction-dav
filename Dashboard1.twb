      <aliases enabled='yes' />
      <column caption='Passes Minimum Rating' datatype='boolean' name='[Calculation_980940294355578880]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Restaurant_Rating]&gt;=[Parameters].[Parameter 1]' />
      </column>
      <column caption='Top_Bottom_Speed_Filter' datatype='boolean' name='[Calculation_980940294364082178]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Fastest&apos; THEN&#13;&#10;    // RANK with &apos;asc&apos; (ascending) selects the lowest delivery times (Fastest)&#13;&#10;    RANK(AVG([Delivery_Time]), &apos;asc&apos;) &lt;= 10&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Slowest&apos; THEN&#13;&#10;    // RANK with &apos;desc&apos; (descending) selects the highest delivery times (Slowest)&#13;&#10;    RANK(AVG([Delivery_Time]), &apos;desc&apos;) &lt;= 10&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
